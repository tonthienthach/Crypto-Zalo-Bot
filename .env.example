# ===========================================================================
# zalo-crypto-bot — environment variables
# Copy this file to `.env` for local development. On Vercel, set each of
# these in Project Settings -> Environment Variables (see docs/DEPLOYMENT.md).
# The app fails fast at boot (see src/config/env.validation.ts) if a required
# variable is missing or has the wrong shape.
# ===========================================================================

# --- Runtime ---------------------------------------------------------------
# NODE_ENV: development | production | test
NODE_ENV=development

# PORT: local HTTP port used by `npm run start:dev`. Unused on Vercel
# (the platform assigns the port to the serverless function itself).
PORT=3000

# LOG_LEVEL: minimum level printed by the Nest Logger.
# One of: debug | log | warn | error | verbose
LOG_LEVEL=debug

# --- Zalo Bot ----------------------------------------------------------------
# ZALO_BOT_TOKEN: issued by https://zalo.me/s/botcreator/ (Zalo Bot Platform)
# when you create a bot there. Shape: "<numeric-id>:<random-string>".
# Used to call the Zalo Bot HTTP API (send messages, setWebhook, etc.).
ZALO_BOT_TOKEN=your-zalo-bot-token-here

# ZALO_API_BASE_URL: base URL of the Zalo Bot HTTP API, confirmed against
# https://bot.zaloplatforms.com/docs/call-api/ — every call is
# `${ZALO_API_BASE_URL}${ZALO_BOT_TOKEN}/<method>`.
ZALO_API_BASE_URL=https://bot-api.zaloplatforms.com/bot

# WEBHOOK_SECRET_TOKEN: the `secret_token` you register via the `setWebhook`
# API call (see docs/SETUP.md). Zalo echoes it back on every webhook POST as
# the `X-Bot-Api-Secret-Token` header; WebhookSecretGuard rejects any request
# whose header doesn't match this value. Must be 8-256 chars.
# Generate a long random string, e.g.: `openssl rand -hex 32`
WEBHOOK_SECRET_TOKEN=change-me-to-a-long-random-string

# --- CoinGecko ---------------------------------------------------------------
# COINGECKO_API_BASE_URL: CoinGecko public REST API base URL (free tier).
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3

# COINGECKO_API_KEY: optional. Leave empty to use the free public tier.
# Set it if you have a CoinGecko Demo/Pro API key to raise rate limits.
COINGECKO_API_KEY=

# COINGECKO_CACHE_TTL_SECONDS: best-effort in-memory cache TTL for CoinGecko
# responses (see docs/ARCHITECTURE.md for the "best-effort cache on
# serverless" caveat — cold starts get an empty cache, and that's fine).
COINGECKO_CACHE_TTL_SECONDS=30

# --- CoinPaprika (free, no API key) -----------------------------------------
# Fallback source used only for symbols CoinGecko couldn't resolve (see
# src/coinpaprika/coinpaprika.service.ts). No base URL/key needed — CoinPaprika's
# free tier requires neither.

# COINPAPRIKA_CACHE_TTL_SECONDS: best-effort in-memory cache TTL for the
# CoinPaprika ticker snapshot (same "best-effort on serverless" caveat as
# COINGECKO_CACHE_TTL_SECONDS above).
COINPAPRIKA_CACHE_TTL_SECONDS=30

# --- Currency conversion -----------------------------------------------------
# USD_TO_VND_RATE: static exchange rate used to display a VND estimate next to
# the USD price. This is NOT a live FX rate; update it periodically by hand.
USD_TO_VND_RATE=25400

# --- Throttling ---------------------------------------------------------------
# THROTTLE_TTL_SECONDS: sliding window size for rate limiting, per user.
THROTTLE_TTL_SECONDS=10

# THROTTLE_LIMIT: max requests allowed per window, per user (see
# src/common/guards and ThrottlerModule config in app.module.ts).
THROTTLE_LIMIT=5

# --- Daily digest cron hook --------------------------------------------------
# CRON_SECRET_TOKEN: shared secret the external scheduler (GitHub Actions
# workflow, see .github/workflows/daily-digest.yml) sends as the
# X-Cron-Secret-Token header when calling POST /cron/daily-digest.
# Generate with: `openssl rand -hex 32`
CRON_SECRET_TOKEN=change-me-to-a-long-random-string

# DIGEST_CHAT_ID: the Zalo chat_id that receives the daily 9am digest.
# Get yours by messaging your bot once, then checking the `chat.id` field of
# the resulting webhook payload (see docs/SETUP.md).
DIGEST_CHAT_ID=your-chat-id-here

# DIGEST_COIN_SYMBOLS: comma-separated ticker symbols sent in the daily
# digest. Defaults to btc,eth,ygg if unset.
DIGEST_COIN_SYMBOLS=btc,eth,ygg
